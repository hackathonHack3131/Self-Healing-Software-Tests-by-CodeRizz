# AegisTest Self-Healing Engine Environment Variables

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aegis_test?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
FLYWAY_ENABLED=false

# Browser Automation (Playwright)
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=100
BROWSER_ACTION_TIMEOUT=5000
BROWSER_NAV_TIMEOUT=10000
BROWSER_CHANNEL=chromium # alternatives: chrome, msedge

# AI Provider Integration (Optional - Falls back to rule-based engine when empty)
AI_PROVIDER=none # options: none, openai, gemini, anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Self-Healing Thresholds
MAX_HEALING_PER_STEP=3
MAX_TOTAL_HEALING=5
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.60

# Demo Settings
DEMO_TARGET_URL=http://localhost:5173
ARTIFACTS_DIR=./artifacts
